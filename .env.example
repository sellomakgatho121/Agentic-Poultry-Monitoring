# ============================================================================
# Boonducks Farm PLF Engine — Environment Variables
# ============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# MODE can be 'live' (needs TimescaleDB) or 'sim' (no DB, synthetic data)
# ============================================================================

# ---- Shared ----
MODE=live

# ---- API Server ----
API_PORT=5000

# ---- PostgreSQL / TimescaleDB ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boonducks_plf
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boonducks_plf

# ---- Modbus Serial Telemetry ----
SERIAL_PORT=/dev/ttyUSB0
BAUDRATE=9600
POLL_INTERVAL=10
