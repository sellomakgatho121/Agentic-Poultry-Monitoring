# ============================================================================
# Boonducks Farm PLF Engine — Environment Variables
# ============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# MODE can be 'live' (needs TimescaleDB) or 'sim' (no DB, synthetic data)
# ============================================================================

# ---- Shared ----
MODE=live

# ---- API Server ----
API_PORT=5000

# ---- PostgreSQL / TimescaleDB ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boonducks_plf
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boonducks_plf

# ---- Modbus Serial Telemetry ----
SERIAL_PORT=/dev/ttyUSB0
BAUDRATE=9600
POLL_INTERVAL=10

# ---- Twilio (WhatsApp / SMS Alerts) ----
# Sign up at https://twilio.com/try-twilio (free trial available)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Your farmer's WhatsApp number (include whatsapp: prefix, e.g. whatsapp:+27820000000)
FARMER_WHATSAPP=
# SMS fallback phone number for critical alerts (without whatsapp: prefix)
FARMER_PHONE=
# Daily WhatsApp summary at 07:00 SAST. Set to 'disabled' to turn off
DAILY_SUMMARY_CRON=enabled

# ---- Internal ----
API_BASE_URL=http://localhost:5000
